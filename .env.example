# ──────────────────────────────────────────────
# STEALTHAP — Environment Variables
# Copy to .env.local and fill in values
# ──────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Aleo Network
NEXT_PUBLIC_ALEO_NETWORK=testnet
NEXT_PUBLIC_ALEO_API_URL=https://api.explorer.provable.com/v1

# Provable Delegated Proving Service
PROVABLE_API_KEY=prov_...
PROVABLE_CONSUMER_ID=cons_...
NEXT_PUBLIC_DPS_PROVER_URL=https://api.provable.com/prove/testnet

# Program IDs (v2 — deployed 2026-04-11)
NEXT_PUBLIC_INVOICE_PROGRAM_ID=stealthap_inv_v2.aleo
NEXT_PUBLIC_PAYMENT_PROGRAM_ID=stealthap_pay_v2.aleo
NEXT_PUBLIC_WORKFLOW_PROGRAM_ID=stealthap_wf_v2.aleo
NEXT_PUBLIC_AUDIT_PROGRAM_ID=stealthap_aud_v2.aleo
NEXT_PUBLIC_BATCH_PROGRAM_ID=stealthap_bat_v2.aleo

# Token Programs (Aleo testnet)
NEXT_PUBLIC_CREDITS_PROGRAM_ID=credits.aleo
NEXT_PUBLIC_USDCX_PROGRAM_ID=test_usdcx_stablecoin.aleo
NEXT_PUBLIC_USAD_PROGRAM_ID=test_usad_stablecoin.aleo

# NVIDIA NIM (AI Invoice Extraction)
NVIDIA_NIM_API_KEY=nvapi-...
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k2.5

# Resend (Email)
RESEND_API_KEY=re_...

# App — Change to production URL before deploy (e.g. https://stealthap.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
